# Maintainer: carcuevas <https://github.com/carcuevas>
pkgname=gotidal
# Overridden at build time from the release tag (see packaging/arch/Dockerfile);
# this default tracks the current major line.
pkgver=1.0.0
pkgrel=1
pkgdesc="Tidal music player for Linux — bit-perfect FLAC via ALSA, MPRIS2, daemon mode"
arch=('x86_64' 'aarch64')
url="https://github.com/carcuevas/gotidal"
license=('Apache-2.0')
depends=('alsa-lib' 'ffmpeg' 'dbus')
makedepends=('go>=1.26')
optdepends=(
    'playerctl: control playback from the command line'
    'kdeconnect: control playback from a phone (MPRIS2 bridge)'
    'cava: spectrum visualizer in the Queue tab'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/carcuevas/gotidal/archive/refs/tags/v$pkgver.tar.gz")
b2sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    # Download module dependencies into the build cache.
    # Use -mod=mod so the vendor directory is not required.
    GOFLAGS="-mod=mod" go mod download
}

build() {
    cd "$pkgname-$pkgver"
    export CGO_ENABLED=1
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    go build \
        -trimpath \
        -buildmode=pie \
        -mod=mod \
        -ldflags "-linkmode=external -X main.version=v$pkgver" \
        -o gotidal \
        ./cmd/gotidal
}

check() {
    cd "$pkgname-$pkgver"
    go test ./...
}

package() {
    cd "$pkgname-$pkgver"

    # Binary
    install -Dm755 gotidal "$pkgdir/usr/bin/gotidal"

    # Desktop file (for tidal:// URL handler; users run 'gotidal setup' to activate)
    install -Dm644 cmd/gotidal/gotidal.desktop \
        "$pkgdir/usr/share/applications/gotidal.desktop"

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0"
}
